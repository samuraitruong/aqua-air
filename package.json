{
  "name": "aqua-air",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "format": "prettier --write app src tests scripts plugins app.config.ts release web",
    "format:check": "prettier --check app src tests scripts plugins app.config.ts release web",
    "benchmark": "node --import tsx scripts/benchmark.ts",
    "assets:brand": "node --import tsx scripts/generate-brand-assets.ts",
    "release:help": "node --import tsx scripts/release.ts help",
    "release:check": "node --import tsx scripts/release.ts check",
    "release:check:links": "node --import tsx scripts/release.ts links",
    "release:prepare:ios": "node --import tsx scripts/release.ts prepare-ios",
    "release:prepare:android": "node --import tsx scripts/release.ts prepare-android",
    "release:ios:verify": "node --import tsx scripts/release.ts ios-verify",
    "release:ios:archive": "node --import tsx scripts/release.ts ios-archive",
    "release:ios:export": "node --import tsx scripts/release.ts ios-export",
    "release:android:aab": "node --import tsx scripts/release.ts android-aab",
    "release:android:apk": "node --import tsx scripts/release.ts android-apk",
    "release:ios": "npm run release:ios:archive && npm run release:ios:export",
    "web:preview": "python3 -m http.server 5501 --bind 127.0.0.1 --directory web",
    "web:check": "node --import tsx --test tests/web.test.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@formatjs/intl-locale": "^5.3.12",
    "@formatjs/intl-pluralrules": "^6.3.16",
    "@noble/hashes": "^2.4.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-native-community/slider": "5.1.2",
    "@react-navigation/native": "^7.1.33",
    "@types/react": "~19.2.10",
    "expo": "~55.0.32",
    "expo-constants": "~55.0.17",
    "expo-crypto": "~55.0.19",
    "expo-document-picker": "~55.0.17",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.18",
    "expo-image-manipulator": "~55.0.21",
    "expo-image-picker": "~55.0.24",
    "expo-linear-gradient": "~55.0.18",
    "expo-linking": "~55.0.17",
    "expo-notifications": "~55.0.27",
    "expo-router": "~55.0.18",
    "expo-sharing": "~55.0.25",
    "expo-splash-screen": "~55.0.25",
    "expo-sqlite": "~55.0.20",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.22",
    "fflate": "^0.8.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "prettier": "^3.8.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2"
  }
}
