{
  "cli": { "appVersionSource": "local" },
  "build": {
    "development": {
      "distribution": "internal",
      "ios": { "simulator": true, "buildConfiguration": "Debug" },
      "android": { "gradleCommand": ":app:assembleDebug" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "production": { "autoIncrement": true }
  }
}
