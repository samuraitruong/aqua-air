{
  "expo": {
    "name": "Aqua Air",
    "slug": "aqua-air",
    "version": "1.0.0",
    "scheme": "aquaair",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.aquaair.app",
      "infoPlist": {
        "CFBundleLocalizations": [
          "vi",
          "en",
          "zh-Hans",
          "hi",
          "es",
          "ar",
          "fr",
          "bn",
          "pt-BR",
          "id",
          "ur"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "1",
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyCollectedDataTypes": []
      }
    },
    "android": {
      "package": "com.aquaair.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "backgroundColor": "#087F8C",
        "monochromeImage": "./assets/brand/monochrome.png"
      },
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Chọn ảnh đại diện cho bể cá của bạn.",
          "cameraPermission": "Chụp ảnh đại diện cho bể cá của bạn.",
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      "expo-font",
      "./plugins/release-signing.cjs"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "locales": {
      "vi": "./assets/locales/vi.json",
      "en": "./assets/locales/en.json",
      "zh-Hans": "./assets/locales/zh.json",
      "hi": "./assets/locales/hi.json",
      "es": "./assets/locales/es.json",
      "ar": "./assets/locales/ar.json",
      "fr": "./assets/locales/fr.json",
      "bn": "./assets/locales/bn.json",
      "pt-BR": "./assets/locales/pt.json",
      "id": "./assets/locales/id.json",
      "ur": "./assets/locales/ur.json"
    },
    "icon": "./assets/brand/icon.png"
  }
}
